{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmapsvn",
  "compatibility_date": "2025-07-15",
  // Site tĩnh: `nuxt generate` prerender toàn bộ (kể cả ảnh @nuxt/image) vào .output/public.
  "assets": {
    "directory": ".output/public",
    "not_found_handling": "404-page"
  },
  // Domain chính (zone vmaps.vn trên Cloudflare), wrangler tự tạo DNS + SSL.
  "routes": [{ "pattern": "vmaps.vn", "custom_domain": true }],
  "observability": { "enabled": true }
}
